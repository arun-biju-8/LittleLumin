# =============================================================================
# LittleLumin Backend Environment Configuration (.env.example)
# Copy this file to .env and configure for local development or Render hosting.
# DO NOT COMMIT ACTUAL SECRETS, PRIVATE KEYS, OR API KEYS.
# =============================================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
# Options: development, staging, production
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins.
# Wildcard '*' is disallowed in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:8000,https://littlelumin-e7d26.web.app,https://littlelumin-e7d26.firebaseapp.com

# Firebase Project Configuration
FIREBASE_PROJECT_ID=littlelumin-e7d26

# Firebase Admin Service Account Credentials
# Option 1: File path to service account JSON file (recommended for local dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Option 2: Raw or Base64-encoded JSON string (recommended for Render environment variables)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"littlelumin-e7d26",...}

# AI Services
GEMINI_API_KEY=your_gemini_api_key_here

# Diagnostic & Debug Endpoints
# Restricts or enables /debug/models (Always requires admin authentication)
ENABLE_DEBUG_ENDPOINTS=false
